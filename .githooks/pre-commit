#!/bin/sh
# Aegis Pre-Commit Hook (Deterministic Iron Cage & Turbo Acceleration)
echo "🛡️  [Aegis] Pre-commit Quality Gate running..."

# Resilient environment PATH resolution across Windows (Git Bash) and POSIX
if [ -n "$APPDATA" ]; then
  export PATH="$PATH:$APPDATA/npm:/c/Program Files/nodejs"
fi
if [ -n "$LOCALAPPDATA" ]; then
  export PATH="$PATH:$LOCALAPPDATA/Programs/nodejs"
fi
export PATH="$PATH:/c/Program Files/nodejs:/usr/local/bin:/usr/bin"

NPM_CMD="npm"
if command -v npm.cmd >/dev/null 2>&1; then
  NPM_CMD="npm.cmd"
fi

echo "🔍 [1/3] Running Iron Cage Architecture & Complexity Gate..."
$NPM_CMD run aegis -- cage:check || {
  echo "❌ [Aegis] Pre-commit rejected: Iron Cage violations detected (max 40 lines/function, max 300 lines/file)."
  exit 1
}

echo "🧪 [2/3] Running Monorepo Unit Test Suite (Turbo Parallel & Cached)..."
$NPM_CMD test || {
  echo "❌ [Aegis] Pre-commit rejected: One or more unit tests failed."
  exit 1
}

echo "🔬 [3/3] Running Mutation Testing Gate on Staged Code Changes..."
$NPM_CMD run aegis -- mutate || {
  echo "❌ [Aegis] Pre-commit rejected: Mutation testing threshold not reached."
  exit 1
}

echo "✅ [Aegis] All Iron Cage quality gates passed. Commit approved."
exit 0
