#!/bin/sh
# Aegis Pre-Commit Hook (Deterministic Iron Cage & Turbo Acceleration)
echo "🛡️  [Aegis] Pre-commit Quality Gate running..."

# Resilient environment PATH resolution across Windows (Git Bash) and POSIX
if [ -n "$APPDATA" ]; then
  export PATH="$PATH:$APPDATA/npm:/c/Program Files/nodejs"
fi
if [ -n "$LOCALAPPDATA" ]; then
  export PATH="$PATH:$LOCALAPPDATA/Programs/nodejs"
fi
export PATH="$PATH:/c/Program Files/nodejs:/usr/local/bin:/usr/bin"

NPM_CMD="npm"
if command -v npm.cmd >/dev/null 2>&1; then
  NPM_CMD="npm.cmd"
fi

echo "🔍 [1/6] Running TypeScript Typecheck..."
$NPM_CMD run typecheck || {
  echo "❌ [Aegis] Pre-commit rejected: TypeScript typecheck failed."
  exit 1
}

echo "🧹 [2/6] Running Biome Lint..."
$NPM_CMD run lint || {
  echo "❌ [Aegis] Pre-commit rejected: Biome lint failed."
  exit 1
}

echo "🔍 [3/6] Running Iron Cage Architecture & Complexity Gate..."
$NPM_CMD run aegis -- cage:check || {
  echo "❌ [Aegis] Pre-commit rejected: Iron Cage violations detected (max 40 lines/function, max 300 lines/file)."
  exit 1
}

echo "🏛️ [4/6] Running Architecture Health Gate (RFC-053)..."
$NPM_CMD run aegis -- arch:health --strict --max-cycles=0 --min-score=95 || {
  echo "❌ [Aegis] Pre-commit rejected: Architecture Health Gate failed."
  exit 1
}

echo "🧪 [5/6] Running Monorepo Unit Test Suite (Turbo Parallel & Cached)..."
$NPM_CMD test || {
  echo "❌ [Aegis] Pre-commit rejected: One or more unit tests failed."
  exit 1
}

echo "🔬 [6/6] Running Mutation Testing Gate (CI Parity)..."
$NPM_CMD run aegis -- mutate packages/core/watchdog/src/pre-execution-estimator.ts packages/core/iron-cage/src/line-budget-radar.ts packages/shared/src/json-safe.ts || {
  echo "❌ [Aegis] Pre-commit rejected: Mutation testing threshold not reached."
  exit 1
}

echo "✅ [Aegis] All Iron Cage quality gates passed. Commit approved."
exit 0
