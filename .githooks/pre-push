#!/bin/sh
# Aegis Pre-Push Hook (Deterministic Iron Cage & Turbo Acceleration)
echo "🛡️  [Aegis] Pre-push Quality Shield running..."

# Resilient environment PATH resolution across Windows (Git Bash) and POSIX
if [ -n "$APPDATA" ]; then
  export PATH="$PATH:$APPDATA/npm:/c/Program Files/nodejs"
fi
if [ -n "$LOCALAPPDATA" ]; then
  export PATH="$PATH:$LOCALAPPDATA/Programs/nodejs"
fi
export PATH="$PATH:/c/Program Files/nodejs:/usr/local/bin:/usr/bin"

NPM_CMD="npm"
if command -v npm.cmd >/dev/null 2>&1; then
  NPM_CMD="npm.cmd"
fi

echo "🔍 [1/2] Running Deterministic Demir Kafes Audit..."
$NPM_CMD run aegis -- cage:check || {
  echo "❌ [Aegis] Pre-push rejected: Iron Cage violations detected."
  exit 1
}

echo "🧪 [2/2] Running Monorepo Unit Test Suite (Turbo Parallel & Cached)..."
$NPM_CMD test || {
  echo "❌ [Aegis] Pre-push rejected: One or more unit tests failed."
  exit 1
}

echo "✅ [Aegis] All pre-push checks passed."
exit 0
