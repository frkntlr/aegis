{
  "name": "@aegis/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Aegis Core CLI - The Autonomous Vibe Coding Harness",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aegis": "dist/bin/aegis.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"const fs=require('fs'),cp=require('child_process'),p=require('path');const f=fs.readdirSync('dist',{recursive:true}).map(String).filter(x=>x.endsWith('.test.js')).map(x=>p.join('dist',x));if(f.length)process.exit(cp.spawnSync(process.execPath,['--test',...f],{stdio:'inherit'}).status||0)\""
  },
  "dependencies": {
    "@aegis/shared": "*",
    "@aegis/watchdog": "*",
    "@aegis/orchestrator": "*",
    "@aegis/iron-cage": "*",
    "@aegis/ast-skeleton": "*",
    "@aegis/compound-checker": "*",
    "@aegis/github-live": "*",
    "@aegis/trust-verifier": "*",
    "@aegis/mcp-security": "*",
    "@aegis/web-dashboard": "*",
    "@aegis/telemetry-tester": "*",
    "@aegis/godot-bridge": "*",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
