{
  "name": "@aegis/web-dashboard",
  "version": "0.1.0",
  "description": "Aegis Command Center Web Dashboard & Real-Time Telemetry Server",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"const fs=require('fs'),cp=require('child_process'),p=require('path');const f=fs.readdirSync('dist',{recursive:true}).map(String).filter(x=>x.endsWith('.test.js')).map(x=>p.join('dist',x));if(f.length)process.exit(cp.spawnSync(process.execPath,['--test','--test-timeout=20000',...f],{stdio:'inherit',timeout:60000}).status||0)\""
  },
  "dependencies": {
    "@aegis/shared": "*",
    "@aegis/orchestrator": "*",
    "@aegis/github-live": "*",
    "@aegis/mcp-security": "*",
    "@aegis/ast-skeleton": "*",
    "@aegis/iron-cage": "*",
    "@aegis/telemetry-tester": "*",
    "@aegis/watchdog": "*",
    "@aegis/trust-verifier": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
