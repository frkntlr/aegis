{
  "name": "@aegis/orchestrator",
  "version": "0.1.0",
  "description": "Aegis Git Worktree and Agent Lifecycle Orchestrator",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"const fs=require('fs'),cp=require('child_process'),p=require('path');const f=fs.readdirSync('dist',{recursive:true}).map(String).filter(x=>x.endsWith('.test.js')).map(x=>p.join('dist',x));if(f.length)process.exit(cp.spawnSync(process.execPath,['--require',p.resolve('../../../scripts/test-workspace.cjs'),'--test','--test-timeout=20000',...f],{stdio:'inherit',timeout:60000}).status??1)\""
  },
  "dependencies": {
    "@aegis/ast-skeleton": "*",
    "@aegis/github-live": "*",
    "@aegis/shared": "*",
    "@aegis/watchdog": "*",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
