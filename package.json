{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis - Autonomous Vibe Coding Engine for Antigravity IDE and Web",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "packages/*",
    "packages/core/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome lint packages/",
    "typecheck": "turbo run typecheck",
    "aegis": "node packages/cli/dist/bin/aegis.js",
    "prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks', {stdio: 'ignore'}) } catch {}\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
