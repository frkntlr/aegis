{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis - Autonomous Vibe Coding Engine for Antigravity IDE and Web",
  "workspaces": [
    "packages/*",
    "packages/core/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "aegis": "node packages/cli/dist/bin/aegis.js",
    "prepare": "git config core.hooksPath .githooks 2>nul || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
