{
  "servers": {
    "notebooklm": {
      "command": "node",
      "args": [
        "packages/plugins/notebooklm/dist/index.js",
        "server"
      ]
    },
    "godot": {
      "command": "node",
      "args": [
        "packages/plugins/godot-bridge/dist/bin/godot-mcp.js"
      ]
    },
    "aegis-engine": {
      "command": "npx",
      "args": [
        "--yes",
        "@aegis/cli",
        "mcp"
      ]
    },
    "aegis": {
      "command": "node",
      "args": [
        "packages/cli/dist/bin/aegis.js",
        "mcp"
      ]
    }
  }
}
