{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "packages/**/src/**/*.ts",
      "packages/**/src/**/*.js",
      "packages/cli/scripts/bundle.mjs",
      "scripts/**/*.js",
      "scripts/**/*.cjs"
    ],
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off",
        "useLiteralKeys": "off",
        "noUselessEscapeInRegex": "off",
        "useOptionalChain": "off"
      },
      "style": {
        "useTemplate": "off",
        "useImportType": "off",
        "noNonNullAssertion": "off"
      }
    }
  }
}
