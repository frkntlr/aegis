{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "packages/**/src/**/*.ts",
      "packages/**/src/**/*.js"
    ],
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noUselessEscapeInString": "off",
        "noGlobalIsNan": "off"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off",
        "useLiteralKeys": "off",
        "noUselessEscapeInRegex": "off",
        "useOptionalChain": "error",
        "useRegexLiterals": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off"
      },
      "style": {
        "useTemplate": "off",
        "useImportType": "off",
        "useExportType": "off",
        "noNonNullAssertion": "error"
      }
    }
  }
}
