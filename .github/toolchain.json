{
  "$schema": "https://aegis.dev/schema/toolchain.json",
  "project_name": "aegis-engine",
  "engine": "web",
  "language": "typescript",
  "runtime": "node-24",
  "test": {
    "unit": "node:test",
    "e2e": "playwright"
  },
  "linters": [
    "eslint",
    "knip"
  ],
  "strict_typing": true,
  "git_provider": "github",
  "ide": "antigravity",
  "agents": {
    "count": 4,
    "names": [
      "solver",
      "qa",
      "docs",
      "contributor"
    ],
    "worktree_prefix": "experimental/",
    "isolated_environments": {
      "solver": {
        "port_range": [3000, 3099],
        "test_db": "aegis_test_solver",
        "env_overrides": {
          "PORT": "3000",
          "DATABASE_URL": "postgresql://localhost:5432/aegis_test_solver"
        }
      },
      "qa": {
        "port_range": [3100, 3199],
        "test_db": "aegis_test_qa",
        "env_overrides": {
          "PORT": "3100",
          "DATABASE_URL": "postgresql://localhost:5432/aegis_test_qa"
        }
      },
      "docs": {
        "port_range": [3200, 3299],
        "test_db": "aegis_test_docs",
        "env_overrides": {
          "PORT": "3200",
          "DATABASE_URL": "postgresql://localhost:5432/aegis_test_docs"
        }
      },
      "contributor": {
        "port_range": [3300, 3399],
        "test_db": "aegis_test_contributor",
        "env_overrides": {
          "PORT": "3300",
          "DATABASE_URL": "postgresql://localhost:5432/aegis_test_contributor"
        }
      }
    }
  },
  "watchdog": {
    "adaptive_timeout": true,
    "base_timeout_seconds": 30,
    "max_ceiling_seconds": 600,
    "stagnation_threshold_seconds": 60,
    "max_retries": 3,
    "issue_token_cap": 50000
  },
  "iron_cage": {
    "max_function_lines": 40,
    "max_file_lines": 300,
    "max_cyclomatic_complexity": 10,
    "forbid_full_file_rewrites": true,
    "require_tdd": true
  }
}
