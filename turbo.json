{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/codex/**",
        "$TURBO_ROOT$/scripts/install-codex-commands*.cjs",
        "$TURBO_ROOT$/scripts/verify-codex-mcp*.cjs",
        "$TURBO_ROOT$/scripts/test-workspace.cjs",
        "src/**",
        "tests/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/tsconfig.tsbuildinfo",
        "dist/**"
      ]
    }
  }
}
